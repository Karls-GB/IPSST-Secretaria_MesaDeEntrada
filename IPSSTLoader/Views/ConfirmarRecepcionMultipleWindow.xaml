<Window x:Class="IPSST.Views.ConfirmarRecepcionMultipleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar Recepcion Multiple" Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ResumenText" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <DataGrid x:Name="SeleccionadosGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nro. Expediente" Binding="{Binding NroExpediente}" Width="150"/>
                <DataGridTextColumn Header="Causante" Binding="{Binding Causante}" Width="*"/>
                <DataGridTextColumn Header="Folios" Binding="{Binding Folios}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,15,0,0">
            <Button Content="Cancelar" Width="90" Margin="0,0,10,0" Click="Cancelar_Click"/>
            <Button Content="Confirmar" Width="90" Click="Confirmar_Click"/>
        </StackPanel>
    </Grid>
</Window>