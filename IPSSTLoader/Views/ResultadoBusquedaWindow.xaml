<ui:FluentWindow x:Class="IPSST.Views.ResultadoBusquedaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:IPSST.Views"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round"
        Background="{StaticResource SuperficieBrush}"
        Title="Resultado de Busqueda" Height="720" Width="900" MinHeight="450" MinWidth="700"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Datos principales: Causante, Asunto, Oficina, Folios -->
        <Style x:Key="EtiquetaPrincipal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
            <Setter Property="Margin" Value="0,4,12,4"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="ValorPrincipal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>

        <!-- Datos secundarios: se mantienen pero con menos peso visual -->
        <Style x:Key="EtiquetaSecundaria" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextoTenueBrush}"/>
            <Setter Property="Margin" Value="0,1,6,1"/>
        </Style>
        <Style x:Key="ValorSecundario" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextoValorSecundarioBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,1,18,1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <views:BarraTitulo Grid.Row="0" Titulo="IPSST - Resultado de Busqueda" PuedeMaximizar="True"/>

    <Grid Grid.Row="1" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Expediente -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Expediente: " FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
            <TextBlock x:Name="NroExpedienteText" FontSize="16" VerticalAlignment="Center"
                       Cursor="Hand" TextDecorations="Underline" Foreground="{StaticResource EnlaceBrush}"
                       MouseLeftButtonDown="NroExpedienteText_MouseLeftButtonDown"
                       ToolTip="Click para copiar"/>
        </StackPanel>

        <!-- Datos principales -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Causante:" Grid.Row="0" Grid.Column="0" Style="{StaticResource EtiquetaPrincipal}"/>
            <TextBlock x:Name="CausanteText" Grid.Row="0" Grid.Column="1" Style="{StaticResource ValorPrincipal}"/>

            <TextBlock Text="Asunto:" Grid.Row="1" Grid.Column="0" Style="{StaticResource EtiquetaPrincipal}"/>
            <TextBlock x:Name="AsuntoText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValorPrincipal}"/>

            <TextBlock Text="Oficina:" Grid.Row="2" Grid.Column="0" Style="{StaticResource EtiquetaPrincipal}"/>
            <StackPanel Grid.Row="2" Grid.Column="1">
                <TextBlock x:Name="OficinaText" Style="{StaticResource ValorPrincipal}"/>
                <TextBlock x:Name="OficinaDestinoText" FontSize="13" Foreground="{StaticResource AdvertenciaBrush}" TextWrapping="Wrap"
                           Margin="0,0,0,4" Visibility="Collapsed"/>
            </StackPanel>

            <TextBlock Text="Folios:" Grid.Row="3" Grid.Column="0" Style="{StaticResource EtiquetaPrincipal}"/>
            <TextBlock x:Name="FoliosText" Grid.Row="3" Grid.Column="1" Style="{StaticResource ValorPrincipal}"/>
        </Grid>

        <!-- Primera observacion (la primera que se agrego): solo el texto de la columna Observaciones -->
        <Grid x:Name="PrimeraObservacionPanel" Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Primera observación:" Grid.Column="0" Style="{StaticResource EtiquetaPrincipal}"/>
            <TextBox x:Name="PrimeraObservacionText" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap"
                     FontSize="13" MaxHeight="80" VerticalScrollBarVisibility="Auto"/>
        </Grid>

        <!-- Trabajado por: se consulta solo si el usuario lo pide -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Trabajado por:" Grid.Column="0" FontSize="13" Foreground="{StaticResource TextoSecundarioBrush}"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Grid Grid.Column="1">
                <Button x:Name="ConsultarTrabajadoPorButton" Content="Consultar" Padding="10,2"
                        HorizontalAlignment="Left" Click="ConsultarTrabajadoPorButton_Click"/>
                <TextBlock x:Name="TrabajadoPorText" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="TrabajadoPorNoAplicaText" FontSize="12" Foreground="{StaticResource TextoTenueBrush}" VerticalAlignment="Center"
                           Text="No aplica: el expediente no está en la oficina" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- Datos secundarios -->
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Fecha alta:" Grid.Row="0" Grid.Column="0" Style="{StaticResource EtiquetaSecundaria}"/>
            <TextBlock x:Name="FechaAltaText" Grid.Row="0" Grid.Column="1" Style="{StaticResource ValorSecundario}"/>
            <TextBlock Text="Motivo:" Grid.Row="0" Grid.Column="2" Style="{StaticResource EtiquetaSecundaria}"/>
            <TextBlock x:Name="MotivoText" Grid.Row="0" Grid.Column="3" Style="{StaticResource ValorSecundario}"/>
            <TextBlock Text="Estado:" Grid.Row="0" Grid.Column="4" Style="{StaticResource EtiquetaSecundaria}"/>
            <TextBlock x:Name="EstadoText" Grid.Row="0" Grid.Column="5" Style="{StaticResource ValorSecundario}"/>

            <TextBlock Text="Sucursal:" Grid.Row="1" Grid.Column="0" Style="{StaticResource EtiquetaSecundaria}"/>
            <TextBlock x:Name="SucursalText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValorSecundario}"/>
            <TextBlock Text="CUIT/CUIL:" Grid.Row="1" Grid.Column="2" Style="{StaticResource EtiquetaSecundaria}"/>
            <TextBlock x:Name="CuitCuilText" Grid.Row="1" Grid.Column="3" Style="{StaticResource ValorSecundario}"/>
        </Grid>

        <!-- Observaciones: primera pagina, el resto a pedido -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock x:Name="ObservacionesTituloText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="CargarTodasButton" Content="Cargar todas" Padding="10,2" Margin="12,0,0,0"
                    Click="CargarTodasButton_Click" Visibility="Collapsed"/>
        </StackPanel>

        <DataGrid x:Name="ObservacionesGrid" Grid.Row="6" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha/Hora" Binding="{Binding FechaHora}" Width="150"/>
                <DataGridTextColumn Header="Observaciones" Binding="{Binding Descripcion}" Width="*"/>
                <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="180"/>
                <DataGridTextColumn Header="Oficina" Binding="{Binding Oficina}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <Popup x:Name="NotificationPopup" Placement="Mouse" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{StaticResource GloboFondoBrush}" CornerRadius="4" Padding="8,4">
                <TextBlock x:Name="PopupText" Foreground="{StaticResource TextoSobreColorBrush}" FontSize="12"/>
            </Border>
        </Popup>
    </Grid>
    </Grid>
</ui:FluentWindow>
