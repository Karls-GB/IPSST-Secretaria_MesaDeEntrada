<Window x:Class="IPSST.Views.ConfirmarResWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar Resolucion" Height="360" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Text="Verifique los datos antes de confirmar:" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,15"/>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<TextBlock Text="Nro. Expediente:" FontWeight="Bold" Grid.Row="0" Grid.Column="0" Margin="0,4,10,4"/>
			<TextBlock x:Name="NroExpedienteText" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4,0,4" VerticalAlignment="Center"/>

			<TextBlock Text="Causante:" FontWeight="Bold" Grid.Row="1" Grid.Column="0" Margin="0,4,10,4"/>
			<TextBlock x:Name="CausanteText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4,0,4"
                       TextWrapping="Wrap" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>

			<TextBlock Text="Nro. Resolucion:" FontWeight="Bold" Grid.Row="2" Grid.Column="0" Margin="0,4,10,4"/>
			<TextBlock x:Name="NroResText" Grid.Row="2" Grid.Column="1" Margin="0,4,10,4"
                       TextWrapping="Wrap" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>

			<TextBlock Text="Fecha Resolucion:" FontWeight="Bold" Grid.Row="2" Grid.Column="2" Margin="0,4,10,4"/>
			<TextBlock x:Name="FechaResText" Grid.Row="2" Grid.Column="3" Margin="0,4,0,4"
                       TextWrapping="Wrap" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>

			<TextBlock Text="Observaciones Resolucion:" FontWeight="Bold" Grid.Row="3" Grid.Column="0" Margin="0,4,10,4" VerticalAlignment="Top"/>
			<TextBlock x:Name="ObservacionesResText" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4,0,4" TextWrapping="Wrap" VerticalAlignment="Center"/>

			<Border Grid.Row="4" Grid.ColumnSpan="4" Height="1" Background="DarkGray" VerticalAlignment="Top" Margin="0,0,0,8"/>

			<TextBlock Text="Oficina:" FontWeight="Bold" Grid.Row="5" Grid.Column="0" Margin="0,4,10,4"/>
			<TextBlock x:Name="OficinaText" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4,0,4" TextWrapping="Wrap" VerticalAlignment="Center"/>

			<TextBlock Text="Folios:" FontWeight="Bold" Grid.Row="6" Grid.Column="0" Margin="0,4,10,4"/>
			<TextBlock x:Name="FoliosText" Grid.Row="6" Grid.Column="1" Margin="0,4,0,4" VerticalAlignment="Center"/>

			<TextBlock Text="Observaciones Pase:" FontWeight="Bold" Grid.Row="7" Grid.Column="0" Margin="0,4,10,4"/>
			<TextBlock x:Name="ObservacionesPaseText" Grid.Row="7" Grid.Column="1" Margin="0,4,0,4" TextWrapping="Wrap"/>
		</Grid>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,15,0,0">
			<Button Content="Cancelar" Width="90" Margin="0,0,10,0" Click="Cancelar_Click"/>
			<Button Content="Confirmar" Width="90" Click="Confirmar_Click"/>
		</StackPanel>
	</Grid>
</Window>