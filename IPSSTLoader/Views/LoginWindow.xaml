<ui:FluentWindow x:Class="IPSST.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Iniciar Sesion" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowCornerPreference="Round"
        Background="{StaticResource FondoBrush}"
        Loaded="LoginWindow_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de titulo con el degradé del logo (el Border pinta el fondo, la TitleBar va encima) -->
        <Border Grid.Row="0" Background="{StaticResource IpsstDegradeBrush}"/>
        <ui:TitleBar Grid.Row="0" Background="Transparent"
                     ShowMinimize="False" ShowMaximize="False" CanMaximize="False"
                     ButtonsForeground="{StaticResource TextoSobreColorBrush}">
            <ui:TitleBar.Header>
                <TextBlock Text="IPSST - Iniciar sesión" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource TextoSobreColorBrush}"/>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Formulario en una tarjeta blanca -->
        <Border Grid.Row="1" Margin="16" Padding="20,16,20,20" CornerRadius="8"
                Background="{StaticResource SuperficieBrush}"
                BorderBrush="{StaticResource BordeBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Usuario" Margin="0,0,0,4" Foreground="{StaticResource TextoSecundarioBrush}"/>
                <TextBox x:Name="UsernameBox"/>

                <TextBlock Text="Contraseña" Margin="0,12,0,4" Foreground="{StaticResource TextoSecundarioBrush}"/>
                <PasswordBox x:Name="PasswordBox"/>

                <ui:Button x:Name="LoginButton" Content="Ingresar" Appearance="Primary"
                           HorizontalAlignment="Stretch" Margin="0,20,0,0"
                           Click="LoginButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
