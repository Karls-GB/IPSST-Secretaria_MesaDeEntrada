<UserControl x:Class="IPSST.Views.BarraTitulo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- Barra de titulo IPSST para ventanas FluentWindow (ExtendsContentIntoTitleBar=True):
         el Border pinta el degradé y la TitleBar de WPF-UI va encima con fondo transparente -->
    <Grid>
        <Border Background="{StaticResource IpsstDegradeBrush}"/>
        <ui:TitleBar x:Name="Barra" Background="Transparent"
                     ShowMinimize="False" ShowMaximize="False" CanMaximize="False"
                     ButtonsForeground="{StaticResource TextoSobreColorBrush}">
            <ui:TitleBar.Header>
                <TextBlock x:Name="TituloText" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource TextoSobreColorBrush}"/>
            </ui:TitleBar.Header>
        </ui:TitleBar>
    </Grid>
</UserControl>
