<Window x:Class="IPSST.Views.PreparandoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IPSST" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource SuperficieBrush}"
        BorderBrush="{StaticResource BordeBrush}" BorderThickness="1">
    <!-- Se muestra entre el login y la ventana principal; sin barra de titulo, no se puede cerrar -->
    <StackPanel>
        <Border Height="6" Background="{StaticResource IpsstDegradeBrush}"/>
        <StackPanel Margin="24,20,24,24">
            <TextBlock Text="IPSST" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource IpsstDegradeBrush}"/>
            <TextBlock Text="Preparando la aplicación..." FontSize="14" Margin="0,6,0,0"
                       Foreground="{StaticResource TextoBrush}"/>
            <TextBlock x:Name="EstadoText" FontSize="12" Margin="0,4,0,14"
                       Foreground="{StaticResource TextoSecundarioBrush}"/>
            <ProgressBar IsIndeterminate="True" Height="4"/>
        </StackPanel>
    </StackPanel>
</Window>
