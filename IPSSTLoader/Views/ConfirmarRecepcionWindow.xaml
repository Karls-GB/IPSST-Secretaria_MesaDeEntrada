<ui:FluentWindow x:Class="IPSST.Views.ConfirmarRecepcionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:IPSST.Views"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round"
        Background="{StaticResource SuperficieBrush}"
        Title="Confirmar Recepcion" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <views:BarraTitulo Grid.Row="0" Titulo="IPSST - Confirmar Recepcion"/>

    <Grid Grid.Row="1" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Verifique los datos antes de confirmar la recepcion:" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,15"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Nro. Expediente:" FontWeight="Bold" Grid.Row="0" Grid.Column="0" Margin="0,4,10,4"/>
            <TextBlock x:Name="NroExpedienteText" Grid.Row="0" Grid.Column="1" Margin="0,4,0,4"/>

            <TextBlock Text="Causante:" FontWeight="Bold" Grid.Row="1" Grid.Column="0" Margin="0,4,10,4"/>
            <TextBlock x:Name="CausanteText" Grid.Row="1" Grid.Column="1" Margin="0,4,0,4" TextWrapping="Wrap"/>

            <TextBlock Text="Oficina Origen:" FontWeight="Bold" Grid.Row="2" Grid.Column="0" Margin="0,4,10,4"/>
            <TextBlock x:Name="OficinaOrigenText" Grid.Row="2" Grid.Column="1" Margin="0,4,0,4" TextWrapping="Wrap"/>

            <TextBlock Text="Folios:" FontWeight="Bold" Grid.Row="3" Grid.Column="0" Margin="0,4,10,4"/>
            <TextBlock x:Name="FoliosText" Grid.Row="3" Grid.Column="1" Margin="0,4,0,4" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,15,0,0">
            <Button Content="Cancelar" Width="90" Margin="0,0,10,0" Click="Cancelar_Click"/>
            <ui:Button Content="Confirmar" Appearance="Primary" Width="90" Click="Confirmar_Click"/>
        </StackPanel>
    </Grid>
    </Grid>
</ui:FluentWindow>
