<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta IPSST (opcion 3: degradé del logo). Unico lugar donde se definen colores. -->

    <!-- Colores del logo -->
    <Color x:Key="IpsstVioletaColor">#321C6E</Color>
    <Color x:Key="IpsstAzulColor">#2C507A</Color>
    <Color x:Key="IpsstPetroleoColor">#286F81</Color>

    <!-- Degradé del logo: barra de titulo e indicador de pestaña activa -->
    <LinearGradientBrush x:Key="IpsstDegradeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource IpsstVioletaColor}" Offset="0"/>
        <GradientStop Color="{StaticResource IpsstAzulColor}" Offset="0.5"/>
        <GradientStop Color="{StaticResource IpsstPetroleoColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IpsstIndicadorBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource IpsstVioletaColor}" Offset="0"/>
        <GradientStop Color="{StaticResource IpsstPetroleoColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Acento: botones principales, foco, checkbox, enlaces -->
    <SolidColorBrush x:Key="AcentoBrush" Color="{StaticResource IpsstAzulColor}"/>
    <SolidColorBrush x:Key="AcentoHoverBrush" Color="#25456A"/>

    <!-- Superficies -->
    <SolidColorBrush x:Key="FondoBrush" Color="#F3F4F7"/>
    <SolidColorBrush x:Key="SuperficieBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BordeBrush" Color="#E0E3EA"/>
    <SolidColorBrush x:Key="BordeControlBrush" Color="#868FA0"/>
    <SolidColorBrush x:Key="SeparadorBrush" Color="#A9A9A9"/>

    <!-- Texto -->
    <SolidColorBrush x:Key="TextoBrush" Color="#1B1C20"/>
    <SolidColorBrush x:Key="TextoSobreColorBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextoSecundarioBrush" Color="#566070"/>
    <SolidColorBrush x:Key="TextoTenueBrush" Color="#868FA0"/>
    <SolidColorBrush x:Key="TextoValorSecundarioBrush" Color="#444444"/>
    <SolidColorBrush x:Key="EnlaceBrush" Color="{StaticResource IpsstAzulColor}"/>

    <!-- Estados -->
    <SolidColorBrush x:Key="ExitoBrush" Color="#2E7D32"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#B3261E"/>
    <SolidColorBrush x:Key="AdvertenciaBrush" Color="#B35900"/>

    <!-- Globo flotante (ej. "Copiado" en el resultado de busqueda) -->
    <SolidColorBrush x:Key="GloboFondoBrush" Color="#333333"/>
</ResourceDictionary>
