<ui:FluentWindow x:Class="IPSST.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:IPSST"
        mc:Ignorable="d"
        Title="IPSST" Height="720" Width="1280"
        MinHeight="480" MinWidth="800"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowCornerPreference="Round"
        Background="{StaticResource FondoBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de titulo con el degradé del logo (el Border pinta el fondo, la TitleBar va encima) -->
        <Border Grid.Row="0" Background="{StaticResource IpsstDegradeBrush}"/>
        <ui:TitleBar Grid.Row="0" Background="Transparent"
                     ButtonsForeground="{StaticResource TextoSobreColorBrush}">
            <ui:TitleBar.Header>
                <TextBlock Text="IPSST" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextoSobreColorBrush}"/>
            </ui:TitleBar.Header>
        </ui:TitleBar>

    <!-- RootGrid: pestañas + avisos (los avisos se agregan desde el codigo, ver ObtenerAviso) -->
    <Grid x:Name="RootGrid" Grid.Row="1">

        <TabControl x:Name="MainTabControl" SelectionChanged="TabControl_SelectionChanged"
                    Style="{StaticResource IpsstTabControl}" ItemContainerStyle="{StaticResource IpsstTabItem}">

            <TabItem Header="Busqueda">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Nro. Expediente:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="NroExpedienteBox" Width="250" VerticalAlignment="Center"/>
                        <ui:Button x:Name="BuscarButton" Appearance="Primary" Content="Buscar" Margin="10,0,0,0"
                                Padding="15,5" Click="BuscarButton_Click"/>
                        <ProgressBar x:Name="BuscandoProgressBar" IsIndeterminate="True" Width="120" Height="18"
                                Margin="15,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="BuscandoText" Text="Buscando..." VerticalAlignment="Center"
                                Margin="8,0,0,0" Foreground="{StaticResource TextoTenueBrush}" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Pase">
                <!-- En pantallas chicas el formulario se desplaza en lugar de cortarse -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Nro. Expediente:" VerticalAlignment="Center" Width="120"/>
                        <TextBox x:Name="PaseNroExpedienteBox" Width="200" VerticalAlignment="Center"/>
                        <CheckBox x:Name="CancelarPaseCheckBox" Content="Cancelar pase" VerticalAlignment="Center" Margin="20,0,0,0"
                                  Checked="CancelarPaseCheckBox_Changed" Unchecked="CancelarPaseCheckBox_Changed"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="Oficina Destino:" VerticalAlignment="Center" Width="120"/>
                        <Grid Width="525">
                            <TextBox x:Name="OficinaTextBox" TextChanged="OficinaTextBox_TextChanged"
                                    PreviewKeyDown="OficinaTextBox_PreviewKeyDown" PreviewGotKeyboardFocus="OficinaTextBox_PreviewGotKeyboardFocus"
                                    GotMouseCapture="OficinaTextBox_GotMouseCapture"/>

                            <Popup x:Name="OficinaPopup" PlacementTarget="{Binding ElementName=OficinaTextBox}"
                                    Placement="Bottom" Width="525" StaysOpen="False" AllowsTransparency="True">
                                <Border Style="{StaticResource IpsstSugerencias}">
                                    <ListBox x:Name="OficinaSuggestionsListBox" MaxHeight="200"
                                            DisplayMemberPath="Nombre"
                                            PreviewMouseLeftButtonUp="OficinaSuggestionsListBox_PreviewMouseLeftButtonUp"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,0,0,10">
                        <TextBlock Text="Folios Nuevos:" VerticalAlignment="Center" Width="120"/>
                        <ui:NumberBox x:Name="FoliosNuevosBox" Width="130" Minimum="0" Maximum="999" MaxDecimalPlaces="0"
                                      SmallChange="1" SpinButtonPlacementMode="Inline" ClearButtonEnabled="False"
                                      TextChanged="FoliosNuevosBox_TextChanged"/>
                        <TextBlock Text="Folios Total:" VerticalAlignment="Center" Margin="24,0,10,0"/>
                        <TextBox x:Name="FoliosTotalBox" Width="100" TextChanged="FoliosTotalBox_TextChanged"/>
                    </StackPanel>

                    <TextBlock Text="Observaciones:" Grid.Row="4" Margin="0,0,0,5"/>
                    <TextBox x:Name="ObservacionesPaseBox" Grid.Row="5" Height="80" TextWrapping="Wrap"
                            AcceptsReturn="False" Margin="0,0,0,15"/>

                    <ui:Button x:Name="ConfirmarPaseButton" Appearance="Primary" Content="Confirmar" Grid.Row="6" Width="120" Padding="10,5"
                            HorizontalAlignment="Left" Click="ConfirmarPaseButton_Click"/>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Resolucion">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Nro. Expediente:" VerticalAlignment="Center" Width="120"/>
                        <TextBox x:Name="ResolucionNroExpedienteBox" Width="200" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Row="0" Height="1" Background="{StaticResource SeparadorBrush}" Margin="0,2" VerticalAlignment="Bottom"/>

                    <TextBlock Text="Resolucion:" Grid.Row="1" Margin="0,0,0,5" FontWeight="Bold"/>

                    <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="Nro. Resolucion:" VerticalAlignment="Center" Width="120"/>
                        <TextBox x:Name="NroResolucionBox" Width="200" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,0,0,10">
                        <TextBlock Text="Fecha Resolucion:" VerticalAlignment="Center" Width="120"/>
                        <!-- es-AR: formato dd/MM/yyyy sin importar el idioma de Windows. Arriba/Abajo suma/resta un dia -->
                        <DatePicker x:Name="FechaResolucionBox" Width="200" VerticalAlignment="Center"
                                    SelectedDateFormat="Short" Language="es-AR"
                                    PreviewKeyDown="FechaResolucionBox_PreviewKeyDown"
                                    Loaded="FechaResolucionBox_Loaded"/>
                    </StackPanel>

                    <TextBlock Text="Observaciones Resolucion:" Grid.Row="4" Margin="0,0,0,5"/>
                    <TextBox x:Name="ObservacionesResolucionBox" Grid.Row="5" Height="80" TextWrapping="Wrap"
                            AcceptsReturn="False" Margin="0,0,0,15" Text="CON RESOLUCION FIRMADA"/>


                    <Border Grid.Row="5" Height="1" Background="{StaticResource SeparadorBrush}" Margin="0,2" VerticalAlignment="Bottom"/>
                    
                    <TextBlock Text="Pase:" Grid.Row="6" Margin="0,0,0,5" FontWeight="Bold"/>

                    <StackPanel Orientation="Horizontal" Grid.Row="7" Margin="0,0,0,10">
                        <TextBlock Text="Oficina Destino:" VerticalAlignment="Center" Width="120"/>
                        <Grid Width="525">
                            <TextBox x:Name="ResolucionOficinaTextBox" TextChanged="ResolucionOficinaTextBox_TextChanged"
                                    PreviewKeyDown="ResolucionOficinaTextBox_PreviewKeyDown" PreviewGotKeyboardFocus="ResolucionOficinaTextBox_PreviewGotKeyboardFocus"
                                    GotMouseCapture="ResolucionOficinaTextBox_GotMouseCapture"/>

                            <Popup x:Name="ResolucionOficinaPopup" PlacementTarget="{Binding ElementName=ResolucionOficinaTextBox}"
                                    Placement="Bottom" Width="525" StaysOpen="False" AllowsTransparency="True">
                                <Border Style="{StaticResource IpsstSugerencias}">
                                    <ListBox x:Name="ResolucionOficinaSuggestionsListBox" MaxHeight="200"
                                            DisplayMemberPath="Nombre"
                                            PreviewMouseLeftButtonUp="ResolucionOficinaSuggestionsListBox_PreviewMouseLeftButtonUp"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="8" Margin="0,0,0,10">
                        <TextBlock Text="Folios Nuevos:" VerticalAlignment="Center" Width="120"/>
                        <ui:NumberBox x:Name="ResolucionFoliosNuevosBox" Width="130" Minimum="0" Maximum="999" MaxDecimalPlaces="0"
                                      SmallChange="1" SpinButtonPlacementMode="Inline" ClearButtonEnabled="False"
                                      TextChanged="ResolucionFoliosNuevosBox_TextChanged"/>
                        <TextBlock Text="Folios Total:" VerticalAlignment="Center" Margin="24,0,10,0"/>
                        <TextBox x:Name="ResolucionFoliosTotalBox" Width="100" TextChanged="ResolucionFoliosTotalBox_TextChanged"/>
                    </StackPanel>

                    <TextBlock Text="Observaciones Pase:" Grid.Row="9" Margin="0,0,0,5"/>
                    <TextBox x:Name="ObservacionesPase2Box" Grid.Row="10" Height="80" TextWrapping="Wrap"
                            AcceptsReturn="False" Margin="0,0,0,15" Text="P/T"/>
                    
                    <ui:Button x:Name="ConfirmarResolucionButton" Appearance="Primary" Content="Confirmar" Grid.Row="11" Width="120" Padding="10,5"
                            HorizontalAlignment="Left" Click="ConfirmarResolucionButton_Click"/>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Recepcion">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Nro. Expediente:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="RecepNroExpedienteBox" Width="250" VerticalAlignment="Center" TextChanged="RecepNroExpedienteBox_TextChanged"/>
                        <ui:Button x:Name="RecepBuscarButton" Appearance="Primary" Content="Recibir" Margin="10,0,0,0"
                                Padding="15,5" Click="RecepBuscarButton_Click"/>
                        <ProgressBar x:Name="RecepBuscandoProgressBar" IsIndeterminate="True" Width="120" Height="18"
                                     Margin="15,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="RecepBuscandoText" Text="Recibiendo..." VerticalAlignment="Center"
                                   Margin="8,0,0,0" Foreground="{StaticResource TextoTenueBrush}" Visibility="Collapsed"/>
                    </StackPanel>

                    <Border Grid.Row="1" Height="1" Background="{StaticResource SeparadorBrush}" Margin="0,5,0,10"/>

                    <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="Oficina Origen:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox   x:Name="RecepOficinaTextBox" TextChanged="RecepOficinaTextBox_TextChanged"
                                   PreviewKeyDown="RecepOficinaTextBox_PreviewKeyDown" PreviewGotKeyboardFocus="RecepOficinaTextBox_PreviewGotKeyboardFocus"
                                   GotMouseCapture="RecepOficinaTextBox_GotMouseCapture"
                                   Width="350" VerticalAlignment="Center"/>
                        
                        <Popup x:Name="RecepOficinaPopup" PlacementTarget="{Binding ElementName=RecepOficinaTextBox}"
                                   Placement="Bottom" Width="350" StaysOpen="False" AllowsTransparency="True">
                                <Border Style="{StaticResource IpsstSugerencias}">
                                    <ListBox x:Name="RecepOficinaSuggestionsListBox" MaxHeight="200"
                                           DisplayMemberPath="Nombre"
                                           PreviewMouseLeftButtonUp="RecepOficinaSuggestionsListBox_PreviewMouseLeftButtonUp"/>
                                </Border>
                            </Popup>
                        <Button x:Name="RecepOficinaBuscarButton" Content="Buscar" Margin="10,0,0,0"
                                Padding="15,5" Click="RecepOficinaBuscarButton_Click"/>
                        <ProgressBar x:Name="RecepOficinaBuscandoProgressBar" IsIndeterminate="True" Width="120" Height="18"
                                     Margin="15,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>

                    <DataGrid x:Name="RecepOficinaGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserReorderColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Recibir" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                            <CheckBox IsChecked="{Binding Path=Seleccionado, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Nro. Expediente" Binding="{Binding NroExpediente}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Asunto" Binding="{Binding Asunto}" Width="200" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Causante" Binding="{Binding Causante}" Width="420" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Folios" Binding="{Binding Folios}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Oficina Origen" Binding="{Binding OficinaOrigen}" Width="200" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ui:Button x:Name="RecepConfirmarSeleccionadosButton" Appearance="Primary" Content="Recibir Seleccionados" Grid.Row="4"
                            Width="180" Padding="10,5" HorizontalAlignment="Left" Click="RecepConfirmarSeleccionadosButton_Click"/>

                </Grid>
            </TabItem>

            <TabItem Header="Historial">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Accion:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="HistorialAccionCombo" Width="140" SelectedIndex="0"
                                  SelectionChanged="HistorialFiltro_SelectionChanged">
                            <ComboBoxItem Content="Todas"/>
                            <ComboBoxItem Content="Busqueda"/>
                            <ComboBoxItem Content="Pase"/>
                            <ComboBoxItem Content="Resolucion"/>
                            <ComboBoxItem Content="Cancelacion"/>
                        </ComboBox>
                        <TextBlock Text="Fecha:" VerticalAlignment="Center" Margin="20,0,8,0"/>
                        <ComboBox x:Name="HistorialFechaCombo" Width="120" SelectedIndex="1"
                                  SelectionChanged="HistorialFiltro_SelectionChanged">
                            <ComboBoxItem Content="Hoy"/>
                            <ComboBoxItem Content="7 dias"/>
                            <ComboBoxItem Content="Todo"/>
                        </ComboBox>
                        <Button Content="Actualizar" Margin="20,0,0,0" Padding="15,5" Click="HistorialActualizarButton_Click"/>
                        <TextBlock x:Name="HistorialCantidadText" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="{StaticResource TextoTenueBrush}"/>
                    </StackPanel>

                    <DataGrid x:Name="HistorialGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Fallido}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha/Hora" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}"/>
                            <DataGridTextColumn Header="Accion" Binding="{Binding Accion}"/>
                            <DataGridTextColumn Header="Expediente" Binding="{Binding NroExpediente}"/>
                            <DataGridTextColumn Header="Causante" Binding="{Binding Causante}" MaxWidth="250"/>
                            <DataGridTextColumn Header="Resultado" Binding="{Binding Resultado}"/>
                            <DataGridTextColumn Header="Detalle" Binding="{Binding Detalle}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn x:Name="HistBuscarColumn">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Buscar de nuevo" Padding="8,2" Click="HistorialBuscarDeNuevo_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Los avisos (uno por pestaña) se crean desde el codigo: ver ObtenerAviso -->
    </Grid>
    </Grid>
</ui:FluentWindow>
