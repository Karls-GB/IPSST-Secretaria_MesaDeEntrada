<Window x:Class="IPSSTLoader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IPSSTLoader"
        mc:Ignorable="d"
        Title="MainWindow" Height="720" Width="1280"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <TabControl x:Name="MainTabControl" Grid.ColumnSpan="2" SelectionChanged="TabControl_SelectionChanged">

            <TabItem Header="Busqueda">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                        <TextBlock Text="Nro. Expediente:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="NroExpedienteBox" Width="250" VerticalAlignment="Center"/>
                        <Button x:Name="BuscarButton" Content="Buscar" Margin="10,0,0,0"
                                Padding="15,5" Click="BuscarButton_Click"/>
                        <ProgressBar x:Name="BuscandoProgressBar" IsIndeterminate="True" Width="120" Height="18"
                                Margin="15,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="BuscandoText" Text="Buscando..." VerticalAlignment="Center"
                                Margin="8,0,0,0" Foreground="Gray" Visibility="Collapsed"/>
                    </StackPanel>

                    <TextBlock Text="Historial de busquedas:" FontWeight="Bold" Grid.Row="1" Margin="934,1,0,19"/>

                    <ListBox x:Name="HistorialListBox" MaxHeight="250" HorizontalAlignment="Left" Width="300"
                                MouseDoubleClick="HistorialListBox_MouseDoubleClick"
                                ToolTip="Doble click para volver a buscar" Margin="934,0,0,14" Grid.RowSpan="2"/>

                </Grid>
            </TabItem>

            <TabItem Header="Pase">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Nro. Expediente:" VerticalAlignment="Center" Width="120"/>
                        <TextBox x:Name="PaseNroExpedienteBox" Width="200" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="Oficina Destino:" Width="120"/>
                        <ComboBox x:Name="OficinaComboBox" Width="350" IsEditable="True" IsTextSearchEnabled="False"
                      DisplayMemberPath="Nombre"
                      TextBoxBase.TextChanged="OficinaComboBox_TextChanged"
                      SelectionChanged="OficinaComboBox_SelectionChanged"/>
                        <TextBlock x:Name="PaseCausanteText" VerticalAlignment="Center" Width="300" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PaseFoliosActualesText" VerticalAlignment="Center"//>

                        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,0,0,10">
                            <TextBlock Text="Folios Nuevos:" Width="110"/>
                            <TextBox x:Name="FoliosNuevosBox" Width="80" TextChanged="FoliosNuevosBox_TextChanged"/>
                            <TextBlock Text="Folios Total:" VerticalAlignment="Center" Width="120" Margin="20,0,0,0"/>
                            <TextBox x:Name="FoliosTotalBox" Width="80" TextChanged="FoliosTotalBox_TextChanged"/>
                        </StackPanel>

                    <TextBlock Text="Observaciones:" Grid.Row="4" Margin="0,0,0,5"/>
                    <TextBox x:Name="ObservacionesPaseBox" Grid.Row="5" Height="80" TextWrapping="Wrap"
                 AcceptsReturn="True" Margin="0,0,0,15"/>

                    <Button x:Name="ConfirmarPaseButton" Content="Confirmar" Grid.Row="6" Width="120" Padding="10,5"
                HorizontalAlignment="Left" Click="ConfirmarPaseButton_Click"/>
                </Grid>
            </TabItem>
            
            <TabItem Header="Resolucion"/>
            <TabItem Header="Recepcion"/>

        </TabControl>

    </Grid>
</Window>
